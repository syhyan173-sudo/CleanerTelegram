# Dapatkan API_ID dan API_HASH dari https://my.telegram.org
# API_ID berupa angka (contoh: 12345678)
API_ID=12345678

# API_HASH berupa teks 32 karakter hexadecimal (contoh: 0123456789abcdef0123456789abcdef)
API_HASH=abcdef0123456789abcdef0123456789

# ==========================================
# PENGATURAN TAMBAHAN (OPSIONAL DARI .ENV)
# ==========================================
# Mode simulasi (true = hanya cek tanpa keluar grup, false = eksekusi beneran)
DRY_RUN=true

# Hapus permanen grup milik sendiri (true = hapus grup jika owner, false = biarkan/keluar)
HAPUS_JIKA_OWNER=false

# Target pembersihan:
# "grup"     = hanya grup
# "channel"  = hanya saluran/channel
# "keduanya" = grup + channel
# "pribadi"  = hanya obrolan pribadi & bot
# "semua"    = grup + channel + obrolan pribadi & bot
TARGET=keduanya

# Lindungi kontak pribadi (teman di kontak HP) agar chatnya TIDAK ikut terhapus
# true = aman, hanya hapus bot & chat orang asing
# false = hapus semua chat pribadi
KECUALIKAN_KONTAK=true

# Jeda antar aksi dalam milidetik (rekomendasi: minimal 2000 ms agar aman dari flood)
JEDA_MS=2000

# Batas maksimal grup yang diproses (0 = tanpa batas / proses semua)
MAKS_PROSES=0

# Filter hari tidak aktif (0 = nonaktif, misal 30 = hanya grup yg pesan terakhirnya > 30 hari lalu)
HARI_TIDAK_AKTIF=0

# Pengecualian nama & ID
KECUALIKAN=
KECUALIKAN_ID=
HANYA_JIKA_MENGANDUNG=
